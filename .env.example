# Copy to .env for local Node or Docker Compose deployments.
# Required for compose.image.yaml ONLY: choose a version that has been published.
# AGENTBRIDGE_IMAGE=ghcr.io/maxtan330/agent-bridge:0.1.0
# Optional Compose build settings; NPM_REGISTRY also applies inside the running container.
# BASE_IMAGE=node:26.13.0-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com
# DEBIAN_MIRROR=http://mirrors.aliyun.com

# Optional Anthropic-compatible gateway override. Leave blank to use Claude configuration and defaults.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
# If your gateway uses x-api-key instead of Bearer, replace AUTH_TOKEN with ANTHROPIC_API_KEY.

# Map each model family to a full model ID served by your gateway.
# Fill the aliases you use; ANTHROPIC_MODEL alone does not map them.
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_FABLE_MODEL=
# Optional default for subagents (an explicit agent model takes precedence).
CLAUDE_CODE_SUBAGENT_MODEL=

# Custom CA for gateways with private certificates (paths must exist inside the container;
# mount the CA file into the agent-data volume first). Blank means unset.
NODE_EXTRA_CA_CERTS=
SSL_CERT_FILE=
SSL_CERT_DIR=

# Feishu: leave application credentials unset. First normal startup prints a QR code.
# Scan with Feishu. The scanner is allowed when Feishu returns their open_id.
# If no open_id is returned, set ALLOWED_USERS before restarting.
# Binding is saved in the data volume.
# Optional name for a newly registered app; does not rename an existing binding.
FEISHU_APP_NAME=AgentBridge
# true: the first-scan confirm page can also choose an existing app you own
# (required scopes/events are requested incrementally on confirmation).
# false (default): the page only allows creating a new app.
FEISHU_SELECT_EXISTING_APP=false
# QR mode without a returned open_id, or an explicit override of the allowed user.
# Compose maps this variable; set it here or in Portainer.
# ALLOWED_USERS=ou_your_user
# Direct binding for an existing published app (manual mode).
# Fill all three plus ALLOWED_USERS; takes precedence over the saved QR binding.
# Compose maps these variables; blank keeps QR-code registration.
# FEISHU_APP_ID=cli_your_app
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_BOT_OPEN_ID=ou_your_bot

# Workspace selection (local Node and Docker Compose).
# Compose always uses /data/workspace inside the container, backed by agent-data.
# Leave '.' to use that directory, or select an existing subdirectory, e.g. my-repo.
# Clone/create any selected subdirectory before starting the service.
WORKSPACE_PROJECT=.

# Local Node ONLY: uncomment and set an existing absolute directory before pnpm start/dev.
# Compose does not read this value or mount this host path.
# To use a host project in Docker, see docs/deployment.md > 使用宿主机已有项目目录.
# WORKSPACE_ROOT=/srv/projects/my-repo

# Total execution deadline, including session startup; default 2 hours, maximum 24 hours.
# Override for long tasks in Compose/Portainer or local Node runs.
TASK_TIMEOUT_MS=7200000

# auto: reply directly for short tasks; notify once if execution exceeds the threshold.
# background: always acknowledge immediately, then notify when finished.
# stream: Typing reaction and live reply updates until the task finishes.
TASK_REPLY_MODE=auto
# Milliseconds before the auto-mode notice: 5000 = 5 seconds, 10000 = 10 seconds.
TASK_BACKGROUND_NOTICE_MS=5000

# Reuse context for continuous work; start fresh after 4 idle hours.
# Running tasks and queued work are not stopped by this idle timeout.
SESSION_IDLE_TIMEOUT_MS=14400000

# Startup cleanup of expired dedup, task, result and session-history rows.
# Default 2592000000 (30 days); range one day to one year. Compose maps this variable.
DATA_RETENTION_MS=2592000000

# Optional JSON with native mcpServers, maxTurns and maxBudgetUsd.
# Relative paths resolve from the selected project. Compose uses container paths.
# CLAUDE_RUNTIME_CONFIG=/data/bridge/claude-runtime.json
# Commit/PR attribution and Claude session links are disabled by Bridge by default.
