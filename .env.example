# Copy to .env for local Node or Docker Compose source deployments.
# Optional Compose build settings; NPM_REGISTRY also applies inside the running container.
# BASE_IMAGE=node:26.13.0-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com
# DEBIAN_MIRROR=http://mirrors.aliyun.com

# Optional Anthropic-compatible gateway override. Leave blank to use Claude configuration and defaults.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
# If your gateway uses x-api-key instead of Bearer, replace AUTH_TOKEN with ANTHROPIC_API_KEY.

# Map each model family to a full model ID served by your gateway.
# Fill the aliases you use; ANTHROPIC_MODEL alone does not map them.
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_FABLE_MODEL=
# Optional default for subagents (an explicit agent model takes precedence).
CLAUDE_CODE_SUBAGENT_MODEL=

# Feishu: leave application credentials unset. First normal startup prints a QR code.
# Scan with Feishu. The scanner is allowed when Feishu returns their open_id.
# If no open_id is returned, set ALLOWED_USERS before restarting.
# For Compose, add an ALLOWED_USERS environment mapping first. Binding is saved in the data volume.
# Optional name for a newly registered app; does not rename an existing binding.
FEISHU_APP_NAME=AgentBridge

# Only for running Node locally; use an existing absolute project path.
# Compose overrides this with /data/workspace, backed by a Docker named volume.
WORKSPACE_ROOT=/srv/projects/my-repo
# Relative project directory within the root; '.' uses /data/workspace in Docker.
# Clone/create any selected subdirectory before starting the service.
WORKSPACE_PROJECT=.

# Total execution deadline, including session startup; default 2 hours, maximum 24 hours.
# Override for long tasks in Compose/Portainer or local Node runs.
TASK_TIMEOUT_MS=7200000
