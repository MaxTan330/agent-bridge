{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "outDir": ".build", "rootDir": "src",
    "rewriteRelativeImportExtensions": true, "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"]
}
